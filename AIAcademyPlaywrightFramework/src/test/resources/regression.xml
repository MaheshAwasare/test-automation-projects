<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Sanity Suite"
       parallel="false"
       preserve-order="true">

    <listeners>
        <listener class-name="com.aiacadamy.listeners.TestListener"/>
    </listeners>

    <test name="Regression Tests">

        <groups>
            <run>
                <include name="Regression"/>
            </run>
        </groups>

        <classes>

            <class name="com.aiacadamy.testngtests.LoginTestNG"/>

            <class name="com.aiacadamy.testngtests.DashboardTestNG"/>

        </classes>

    </test>

</suite>