<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Smoke Suite"
       parallel="false"
       preserve-order="true">

    <listeners>
        <listener class-name="com.aiacadamy.listeners.TestListener"/>
    </listeners>

    <test name="Smoke Tests">

        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>

        <classes>
            <class name="com.aiacadamy.testngtests.LoginTestNG"/>
            <class name="com.aiacadamy.testngtests.ProfileTestNG"/>
        </classes>

    </test>

</suite>